<?xml version="1.0" encoding="iso-8859-1"?>

<root>
    <windowclass name="charsheet_main_nimble">
        <script file="campaign/scripts/char_main.lua" />
        <sheetdata>
            <!-- Ancestry link button-->
            <linkfield_record name="ancestrylink">
                <bounds>0,0,20,20</bounds>
                <class>reference_ancestry</class>
                <description field="ancestry" />
                <hideonempty />
                <nodrag />
                <readonly />
            </linkfield_record>

            <!-- Ancestry string label -->
            <string_labeled name="ancestry">
                <bounds>25,0,100,30</bounds>
                <labelres>ancestry</labelres>
            </string_labeled>

            <genericcontrol name="stats_box">
                <anchored position="insidetopleft" offset="0,48" width="150" height="180" />
                <frame name="groupbox" offset="5,5,5,5" />
            </genericcontrol>

            <genericcontrol name="anchor_stats">
                <anchored to="stats_box" position="insidetop" height="0" />
            </genericcontrol>

            <stringcontrol name="stats_title_label">
                <anchored to="anchor_stats">
                    <top anchor="bottom" relation="relative" offset="10" />
                    <left offset="10" />
                    <right offset="-10" />
                    <size height="20" />
                </anchored>
                <font>reference-b</font>
                <static>ATTRIBUTES</static>
                <center /> 
                <color>555555</color>
            </stringcontrol>

            <!-- STRENGTH-->
            <genericcontrol name="strength_row">
                <anchored to="anchor_stats">
                    <top anchor="bottom" relation="relative" offset="0" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="32" />
                </anchored>
            </genericcontrol>

            <stringcontrol name="strength_label">
                <anchored to="strength_row" position="insideleft" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="100" />
                </anchored>
                <font>reference-b</font>
                <static textres="strength" />
            </stringcontrol>

            <number_statscore name="strength_score" source="attributes.strength">
                <anchored to="strength_row" position="insideright" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="32" />
                </anchored>
            </number_statscore>

            <!-- DEXTERITY-->
            <genericcontrol name="dexterity_row">
                <anchored to="anchor_stats">
                    <top anchor="bottom" relation="relative" offset="0" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="32" />
                </anchored>
            </genericcontrol>

            <stringcontrol name="dexterity_label">
                <anchored to="dexterity_row" position="insideleft" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="100" />
                </anchored>
                <font>reference-b</font>
                <static textres="dexterity" />
            </stringcontrol>

            <number_statscore name="dexterity_score" source="attributes.dexterity">
                <anchored to="dexterity_row" position="insideright" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="32" />
                </anchored>
            </number_statscore>

            <!-- INTELLIGENCE-->
            <genericcontrol name="intelligence_row">
                <anchored to="anchor_stats">
                    <top anchor="bottom" relation="relative" offset="0" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="32" />
                </anchored>
            </genericcontrol>

            <stringcontrol name="intelligence_label">
                <anchored to="intelligence_row" position="insideleft" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="100" />
                </anchored>
                <font>reference-b</font>
                <static textres="intelligence" />
            </stringcontrol>

            <number_statscore name="intelligence_score" source="attributes.intelligence">
                <anchored to="intelligence_row" position="insideright" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="32" />
                </anchored>
            </number_statscore>

            <!-- WILLPOWER-->
            <genericcontrol name="will_row">
                <anchored to="anchor_stats">
                    <top anchor="bottom" relation="relative" offset="0" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="32" />
                </anchored>
            </genericcontrol>

            <stringcontrol name="will_label">
                <anchored to="will_row" position="insideleft" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="100" />
                </anchored>
                <font>reference-b</font>
                <static textres="will" />
            </stringcontrol>

            <number_statscore name="will_score" source="attributes.will">
                <anchored to="will_row" position="insideright" offset="0,0">
                    <top anchor="top" />
                    <bottom anchor="bottom" />
                    <size width="32" />
                </anchored>
            </number_statscore>
        </sheetdata>
    </windowclass>
</root>