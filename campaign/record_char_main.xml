<?xml version="1.0" encoding="iso-8859-1"?>

<root>
    <windowclass name="charsheet_main_nimble">
        <script file="campaign/scripts/char_main.lua" />
        <sheetdata>
            <!-- Ancestry link button-->
            <linkfield_record name="ancestrylink">
                <bounds>0,0,20,20</bounds>
                <class>reference_ancestry</class>
                <description field="ancestry" />
                <hideonempty />
                <nodrag />
                <readonly />
            </linkfield_record>

            <!-- Ancestry string label -->
            <string_labeled name="ancestry">
                <bounds>25,0,100,30</bounds>
                <labelres>ancestry</labelres>
            </string_labeled>

            <!-- Attributes -->
            <!--
            <anchor_column name="columnanchor_attributes">
                <anchored position="insidetopleft" offset="20,60" width="70" height="200" />
                <frame name="groupbox" offset="0,0,0,0" />
            </anchor_column>
            -->

            <genericcontrol name="attributes_box">
                <anchored position="insidetopleft" offset="20,60" width="70" height="260" />
            </genericcontrol>

            <genericcontrol name="columnanchor_attributes">
                <anchored to="attributes_box" position="insidetop" height="0" />
            </genericcontrol>

            <number_abilityscore name="strength" source="attributes.strength">
                <anchored to="columnanchor_attributes">
                    <top anchor="bottom" relation="relative" offset="10" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="50" />
                </anchored>
                <labelres>strength_short</labelres>
            </number_abilityscore>

            <number_abilityscore name="dexterity" source="attributes.dexterity">
                <anchored to="columnanchor_attributes">
                    <top anchor="bottom" relation="relative" offset="10" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="50" />
                </anchored>
                <labelres>dexterity_short</labelres>
            </number_abilityscore>

            <number_abilityscore name="intelligence" source="attributes.intelligence">
                <anchored to="columnanchor_attributes">
                    <top anchor="bottom" relation="relative" offset="10" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="50" />
                </anchored>
                <labelres>intelligence_short</labelres>
            </number_abilityscore>

            <number_abilityscore name="wisdom" source="attributes.wisdom">
                <anchored to="columnanchor_attributes">
                    <top anchor="bottom" relation="relative" offset="10" />
                    <left offset="5" />
                    <right offset="-5" />
                    <size height="50" />
                </anchored>
                <labelres>wisdom_short</labelres>
            </number_abilityscore>
        </sheetdata>
    </windowclass>
</root>